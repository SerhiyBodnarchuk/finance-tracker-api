{
  "mcpServers": {
    "finance-mcp": {
      "type": "stdio",
      "command": "dotnet",
      "args": [
        "run",
        "--quiet",
        "--project",
        "src/backend/FinanceTracker/Finance.Mcp.Host"
      ]
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PAT}"
      }
    },
    "sdlc-cgen": {
      "type": "http",
      "url": "https://mcpplatformapim.azure-api.net/sdlc-cgen/mcp"
    }
  }
}
